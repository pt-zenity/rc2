{
  "name": "recon-suite-server",
  "version": "0.1.0",
  "private": true,
  "description": "Web Application Reconnaissance Suite - API + Worker",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
    "migrate": "node dist/db/migrate.js",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/index.js",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker/index.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "bullmq": "5.81.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.2",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.0",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.2"
  }
}
